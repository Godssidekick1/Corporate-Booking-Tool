<?xml version="1.0" encoding="utf-8"?>
<!--
  CBT behind IIS: IIS holds the HTTPS certificate and forwards every request
  to the Node server on this machine (http://127.0.0.1:3000), which nothing
  else can reach. Needs the IIS URL Rewrite and Application Request Routing
  (ARR) modules, and deploy/iis/configure-iis.ps1 run once (it enables ARR's
  proxy and allows the forwarded headers set below). docs/deploy-windows.md.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Plain HTTP is never served: sign-in needs HTTPS (the session cookie
             is Secure, and the browser seals the password with Web Crypto). -->
        <rule name="HTTPS only" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{UNENCODED_URL}" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <!-- Everything else goes to the app. {UNENCODED_URL} (path and query as
             the browser sent them) keeps encoded characters intact: flight keys
             in booking addresses carry %2F and the like, which {R:1} would
             decode and break. -->
        <rule name="CBT app" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>

    <!-- The app's own error answers (JSON for the API, its pages otherwise)
         pass through untouched instead of IIS's error pages. -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <!-- allowDoubleEscaping: encoded characters in flight keys (above).
           10 MB: refund attachments are at most 5 MB. -->
      <requestFiltering allowDoubleEscaping="true" removeServerHeader="true">
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
