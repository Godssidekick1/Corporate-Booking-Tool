/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# ── Database dumps ───────────────────────────────────────────────────────────
# schema/baseline.sql and schema/auth_baseline.sql ARE committed — they are the
# only complete description of 14 tables that have no CREATE TABLE in
# supabase/migrations, so losing them loses the schema.
#
# Everything holding ROWS is excluded. seed.sql carries live passenger detail:
# bookings.traveler_snapshot freezes full CustomerInfo including passport
# numbers, and that must not reach a git history that outlives any retention
# policy we later write.
schema/seed.sql
schema/*_data.sql
schema/*.dump
schema/restore_*.log
*.backup
